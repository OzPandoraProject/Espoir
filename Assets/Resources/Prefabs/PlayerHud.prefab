  m_Name: 
  m_EditorClassIdentifier: 
  _cooldownText: {fileID: 4176082037713751112}
  _durationFill: {fileID: 9062063165339152277}
  _skillIcon: {fileID: 7928886410014495152}
  _name: "\uB808\uBE44\uC544\uD0C4"
  _tooltipUI: {fileID: 3943876537828473529}
  _tooltipText: "MP 100 / \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 60\uCD08\n#
    \uAC15\uD654 : \uCD5C\uB300 30\uCD08\n\uACF5\uACA9\uB825 | +30%\n\uCE58\uBA85\uD0C0
    \uD655\uB960 | +30%\n\uC911\uCCA9 | +1 | \uAE30\uBCF8 \uACF5\uACA9 \uB9C8\uC9C0\uB9C9
    \uD0C0\uACA9 \uB610\uB294 Q \uC801\uC911(\uC2DC\uC804\uB2F9 1\uD68C), \uCD5C\uB300 10\n# \uB9C8\uBB34\uB9AC
    \uACF5\uACA9 : 30\uCD08\uAC00 \uC9C0\uB098\uAC70\uB098 R\uC744 \uB2E4\uC2DC \uB204\uB974\uBA74\n\uD53C\uD574
    | 19.0attack | 10\uD68C \uD0C0\uACA9\n10\uC911\uCCA9\uC77C \uB54C | 39.0attack
    | 30\uD68C \uD0C0\uACA9 | \uD53C\uD574 \xB7 10\uC911\uCCA9\n\uC9C8\uD22C\uC758
    \uB099\uC778 | 5\uC911\uCCA9 | \uCCAB \uC801\uC911 \uC2DC \xB7 \uC774\uD6C4 \uC801\uC911\uB9C8\uB2E4
    \uC9C0\uC18D\uC2DC\uAC04 \uAC31\uC2E0\n# \uC804\uD22C\uC758 \uD750\uB984 50\uC911\uCCA9
    : \uC774 \uC0C1\uD0DC\uB85C R\uC744 \uCC98\uC74C \uC0AC\uC6A9\uD558\uBA74\n\uB9C8\uC9C0\uB9C9
    10\uD68C \uD0C0\uACA9 | \uBC29\uC5B4\uB825 25% \uBB34\uC2DC\n\uB9C8\uC9C0\uB9C9
    \uD0C0\uACA9 | \uBC18\uB4DC\uC2DC \uCE58\uBA85\uD0C0"
