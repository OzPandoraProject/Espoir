  _places:
  - mapKey: m51
    areaName: "\uB098\uD0DC\uC758 \uC601\uC5ED"
    placeName: "\uBCA8\uD398\uACE0\uB974 \uC0AC\uB9C9"
    about:
    - "\uB05D\uC5C6\uB294 \uBAA8\uB798\uC640 \uC878\uC74C\uC774 \uB0B4\uB824\uC549\uC740
      \uB545\uC774\uC9C0. \uBA48\uCDB0 \uC120 \uC790\uB294 \uBAA8\uB798\uC5D0 \uBB3B\uD788\uACE0,
      \uAC77\uB294 \uC790\uB9CC \uAE38\uC744 \uCC3E\uB294\uB2E4\uB124."
    hello:
    - "\uC0AC\uB9C9\uC774\uB77C.."
    - "\uC774 \uBAA8\uB4E0\uAC83\uB4E4\uC774 \uC2A4\uB7EC\uC838 \uD769\uC5B4\uC84C\uAD6C\uB098.
      \uC790\uC2E0\uB3C4 \uBAA8\uB974\uB294 \uCC44\uB85C."
  - mapKey: c2a
    areaName: "\uC0C9\uC695\uC758 \uC601\uC5ED"
    placeName: "\uB2EC\uBE5B \uC7A5\uBBF8 \uC815\uC6D0"
    about:
    - "\uC0AC\uB791\uBC1B\uB294 \uBAA8\uC2B5\uC5D0 \uAC07\uD78C \uC815\uC6D0\uC774\uB77C\uB124.
      \uAF43\uACFC \uD5A5\uAE30, \uAC00\uBA74\uACFC \uBB34\uB300\u2026 \uAC89\uC740
      \uB208\uBD80\uC2DC\uC9C0\uB9CC \uC624\uB798 \uBA38\uBB3C \uACF3\uC740 \uBABB
      \uB418\uC9C0."
    hello:
    - "\uD5A5\uAE30\uC5D0 \uCDE8\uD558\uC9C4 \uC54A\uC558\uB098? \uC774 \uC815\uC6D0\uC758
      \uAF43\uB0B4\uC74C\uC740 \uC815\uC2E0\uC744 \uD750\uB9AC\uAC8C \uD558\uC9C0."
    - "\uB610 \uB9CC\uB0AC\uAD70. \uB098\uB294 \uC5B4\uB514\uC5D0\uB4E0 \uC788\uB2E4\uB124
      \u2014 \uAE38\uC774 \uC788\uB294 \uACF3\uC774\uB77C\uBA74. \uB2E4\uC74C \uAE38\uC774
      \uD544\uC694\uD558\uBA74 \uB9D0\uD558\uAC8C."
  - mapKey: c3a
    areaName: "\uC624\uB9CC\uC758 \uC601\uC5ED"
    placeName: "\uCC9C\uACF5\uC758 \uD0D1"
    about:
    - "\uAD6C\uB984 \uC704\uC5D0 \uB72C \uD770 \uC131\uCC44\uB77C\uB124. \uBAA8\uB450\uAC00
      \uC2A4\uC2A4\uB85C\uB97C \uC2E0\uC774\uB77C \uBBFF\uB294 \uACF3\uC774\uC9C0.
      \uC62C\uB77C\uAC08\uC218\uB85D \uBC1C\uBC11\uC744 \uC870\uC2EC\uD558\uAC8C."
    hello:
    - "\uC5EC\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uC624\uB2E4\uB2C8, \uC228\uC774 \uCC28\uC9C4
      \uC54A\uB098? \uAD6C\uB984 \uC704 \uACF5\uAE30\uB294 \uC0AC\uB78C\uC744 \uC624\uB9CC\uD558\uAC8C
      \uB9CC\uB4E4\uC9C0."
    - "\uC774 \uC131\uCC44\uC758 \uAE38\uC740 \uAC00\uD30C\uB974\uB2E4\uB124. \uB0B4\uB824\uAC00\uACE0
      \uC2F6\uB2E4\uBA74 \uC5B8\uC81C\uB4E0 \uB9D0\uD558\uAC8C, \uB0B4\uAC00 \uAE38\uC744
      \uC774\uC5B4 \uC8FC\uC9C0."
  _menuAskFormat: "\uC790, \uC5B4\uB514\uB85C \uAC00\uACA0\uB098?"
  _goChoiceFormat: "{0}\uC73C\uB85C \uBCF4\uB0B4 \uC918"
  _aboutChoice: "\uADF8\uACF3\uB4E4\uC740 \uC5B4\uB5A4 \uACF3\uC774\uC9C0?"
  _byeChoice: "\uC544\uC9C1\uC740 \uB410\uC5B4"
  _aboutHeaderFormat: "{0} \u2014 {1}."
  _goLineFormat: "\uC88B\uC544, {0}\uC774\uB2E4. \uB9C8\uCC28\uC5D0 \uC62C\uB77C\uD0C0\uAC8C\uB098.."
  _byeLines:
  - "\uADF8\uB7EC\uAC8C. \uB9C8\uC74C\uC774 \uC815\uD574\uC9C0\uBA74 \uB2E4\uC2DC
    \uC624\uAC8C\uB098."
