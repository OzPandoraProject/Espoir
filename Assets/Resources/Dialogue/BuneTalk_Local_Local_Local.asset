  _startNode: hello
  _summonedStartNode: 
  _nodes:
  - id: hello
    lines:
    - "\uC624, \uC9C8\uD22C\uC758 \uAD70\uC8FC\uAED8\uC11C \uC774 \uBAA8\uB798\uB545\uAE4C\uC9C0
      \uC9C1\uC811 \uC624\uC2DC\uB2E4\uB2C8. \uBC18\uAC11\uAD70."
    - "\uB098\uB294 \uBD80\uB124. \uD0D0\uC695\uC758 \uAD70\uC8FC\uB77C \uBD88\uB9AC\uC9C0.
      \uC5EC\uAE30\uC120 \uADF8\uC800 \uBB3C\uAC74\uACFC \uC18C\uBB38\uC744 \uC0AC\uACE0\uD30C\uB294
      \uC7A5\uC0AC\uAFBC\uC77C \uBFD0\uC774\uC9C0\uB9CC."
    ask: 
    choices: []
    next: menu
    end: 0
    dest: 
  - id: menu
    lines: []
    ask: "\uC790, \uBB34\uC5C7\uC744 \uAC70\uB798\uD558\uACA0\uB098? \uAC12\uC740\u2026
      \uB9D0\uD558\uAE30 \uB098\uB984\uC774\uC9C0."
    choices:
    - text: "\uBB34\uC5C7\uC744 \uD314\uACE0 \uC788\uC9C0?"
      to: wares
    - text: "\uB0B4\uAC00 \uC6D0\uD558\uB294 \uAC78 \uC54C\uACE0 \uC788\uB098?"
      to: want
    - text: "\uC624\uB298\uC740 \uAD6C\uACBD\uB9CC \uD560\uAC8C"
      to: bye
    next: 
    end: 0
    dest: 
  - id: wares
    lines:
    - "\uAE08, \uD5A5\uC2E0\uB8CC, \uC78A\uD78C \uC774\uB984\uB4E4\u2026 \uADF8\uB9AC\uACE0
      \uC815\uBCF4. \uC774 \uC0AC\uB9C9\uC758 \uC228\uC740 \uAE38 \uD558\uB098\uCBE4\uC740
      \uC804\uBD80 \uB0B4 \uC7A5\uBD80\uC5D0 \uC801\uD600 \uC788\uC9C0."
    - "\uBB3C\uB860 \uACF5\uC9DC\uB294 \uC5C6\uB2E4\uB124. \uAC00\uC9C4 \uAC83\uC744
      \uB0B4\uB193\uC744 \uAC01\uC624\uAC00 \uC788\uB2E4\uBA74 \uC598\uAE30\uAC00
      \uB2EC\uB77C\uC9C0\uACA0\uC9C0\uB9CC."
    ask: 
    choices: []
    next: 
    end: 5
    dest: 
  - id: want
    lines:
    - "\uC9C8\uD22C\uD558\uB294 \uC790\uB294 \uB298 \uB0A8\uC758 \uAC83\uC744 \uBCF4\uC9C0.
      \uADF8\uB300\uAC00 \uAC00\uC9C4 \uAC78 \uD0D0\uB0B4\uB294 \uB098\uC640\uB294
      \uC798 \uB9DE\uC744 \uAC70\uC57C."
    - "\uADF8\uB300\uAC00 \uC190\uC5D0 \uB123\uACE0 \uC2F6\uC740 \uAC83, \uB0B4\uAC00
      \uAD6C\uD574 \uC8FC\uC9C0. \uB300\uC2E0 \uADF8\uB9CC\uD55C \uAC12\uC740 \uBC1B\uC544
      \uAC00\uACA0\uB124."
    ask: 
    choices: []
    next: menu
    end: 0
    dest: 
  - id: bye
    lines:
    - "\uC88B\uC544. \uC7A5\uBD80\uB294 \uB298 \uD3BC\uCCD0 \uB450\uC9C0. \uB9C8\uC74C\uC774
      \uBC14\uB00C\uBA74 \uB2E4\uC2DC \uC624\uAC8C, \uC9C8\uD22C\uC758 \uAD70\uC8FC."
    ask: 
    choices: []
    next: 
    end: 1
    dest: 
