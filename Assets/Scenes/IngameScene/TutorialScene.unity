      \uB2E4\uC2DC \uCC44\uC6CC \uBCF4\uC138\uC694"
    powerReady: "\uC5F0\uC2B5\uC774\uB77C \uAD8C\uB2A5 \uB300\uAE30\uC2DC\uAC04\uC744
      \uD480\uC5B4 \uC92C\uC5B4\uC694"
    crownWindowClosed: "W\uB294 \uB9C9\uD0C0 \uB4A4 2\uCD08 \uC548\uC5D0\uB9CC \uC4F8
      \uC218 \uC788\uC5B4\uC694. \uBC1C\uBC11 W \uC904\uC744 \uBCF4\uC138\uC694"
    skillReady: "\uC5F0\uC2B5\uC774\uB77C \uB300\uAE30\uC2DC\uAC04\uC744 \uD480\uC5B4
      \uC92C\uC5B4\uC694"
    manaRestored: "\uC5F0\uC2B5\uC774\uB77C MP\uB97C \uCC44\uC6CC \uC92C\uC5B4\uC694"
    finisherTooEarly: "\uC5F4 \uCE78\uC744 \uCC44\uC6B0\uAE30 \uC804\uC5D0 \uD130\uB728\uB838\uC5B4\uC694.
      \uC5F4 \uCE78\uC744 \uCC44\uC6B0\uBA74 30\uC5F0\uACA9\uC774\uC5D0\uC694. R\uB85C
