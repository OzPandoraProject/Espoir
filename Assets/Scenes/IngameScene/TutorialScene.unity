    outOfRange: "\uD5C8\uC218\uC544\uBE44\uAC00 \uBA40\uC5B4\uC694. \uC624\uB978\uCABD
      \uD074\uB9AD\uC73C\uB85C \uAC00\uAE4C\uC774 \uAC00\uC138\uC694"
    missedAttack: "\uACF5\uACA9\uC740 \uB9C8\uC6B0\uC2A4 \uCABD\uC73C\uB85C \uB098\uAC00\uC694.
      \uCEE4\uC11C\uB97C \uD5C8\uC218\uC544\uBE44\uC5D0 \uB450\uACE0 \uCE58\uC138\uC694"
    bagFull: "\uAC00\uBC29\uC774 \uAC00\uB4DD \uCC28\uC11C \uBABB \uB123\uC5C8\uC5B4\uC694.
      \uD55C \uCE78 \uBE44\uC6B0\uBA74 \uB2E4\uC2DC \uB123\uC5B4 \uC904\uAC8C\uC694"
